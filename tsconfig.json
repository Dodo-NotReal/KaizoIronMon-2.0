{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "rootDir": ".",
    "outDir": "dist",
    "declaration": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "useDefineForClassFields": false
  },
  "include": ["index.ts", "battle-engine.ts", "battle-core/**/*.ts", "battle-text/**/*.ts", "examples/**/*.ts"],
  "exclude": ["dist", "node_modules", "_source"]
}
