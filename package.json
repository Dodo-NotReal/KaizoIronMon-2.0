{
  "name": "kaizo-ironmon-battle-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Headless Pokémon Showdown battle and English battle text engine",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": { "node": ">=22.18.0" },
  "scripts": {
    "prebuild": "node tools/clean.mjs",
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node tools/audit.mjs && node --test dist/tests/*.test.js",
    "example": "npm run build && node dist/examples/basic-battle.js",
    "audit": "node tools/audit.mjs"
  },
  "dependencies": {
    "ts-chacha20": "^1.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "typescript": "^5.8.3"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Dodo-NotReal/KaizoIronMon-2.0.git"
  }
}
